// Prisma schema for wacrm.
//
// Source of truth for migrations going forward (`prisma/migrations/`).
// The 42 migrations in `supabase/migrations/` were carried over verbatim
// into `prisma/migrations/` (see migration folder names) to preserve
// history — Prisma just replays the same SQL. `docs/prisma-migrations.md`
// covers baselining an existing database and running new migrations.
//
// `auth` and `storage` are Supabase-managed schemas this project reads/
// references (RLS policies, `auth.users` FKs, storage buckets) but never
// migrates — hence `multiSchema`. Their models below were introspected
// from a local Supabase instance and won't have every column a hosted
// project's `auth`/`storage` schema does; that's fine, the app talks to
// those through Supabase's own client, not Prisma.
//
// Regenerate with `npm run db:pull` after any migration that changes
// `public` schema shape; the RLS/check-constraint/comment warnings it
// prints are expected (documented limitations, not errors — see
// docs/prisma-migrations.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public", "storage"]
}


/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_log_entries {
  instance_id String?   @db.Uuid
  id          String    @id @db.Uuid
  payload     Json?     @db.Json
  created_at  DateTime? @db.Timestamptz(6)

  @@index([instance_id], map: "audit_logs_instance_id_idx")
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model instances {
  id              String    @id @db.Uuid
  uuid            String?   @db.Uuid
  raw_base_config String?
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)

  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model refresh_tokens {
  instance_id String?   @db.Uuid
  id          BigInt    @id @default(autoincrement())
  token       String?   @db.VarChar(255)
  user_id     String?   @db.VarChar(255)
  revoked     Boolean?
  created_at  DateTime? @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)

  @@index([instance_id])
  @@index([instance_id, user_id])
  @@index([token])
  @@schema("auth")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model schema_migrations {
  version String @id @db.VarChar(255)

  @@schema("auth")
}

