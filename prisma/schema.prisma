  users                   users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_whatsapp_config_account")
  @@schema("public")
}

model buckets {
  id                 String    @id
  name               String
  owner              String?   @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  public             Boolean?  @default(false)
  avif_autodetection Boolean?  @default(false)
  file_size_limit    BigInt?
  allowed_mime_types String[]
  owner_id           String?
  objects            objects[]

  @@schema("storage")
}

model objects {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket_id        String?
  name             String?
  owner            String?   @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  last_accessed_at DateTime? @default(now()) @db.Timestamptz(6)
  metadata         Json?
  version          String?
  owner_id         String?
  user_metadata    Json?
  buckets          buckets?  @relation(fields: [bucket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("storage")
}

enum account_role_enum {
  owner
  admin
  agent
  viewer

  @@schema("public")
}
