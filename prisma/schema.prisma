  recovery_sent_at                                                   DateTime?                       @db.Timestamptz(6)
  email_change_token                                                 String?                         @db.VarChar(255)
  email_change                                                       String?                         @db.VarChar(255)
  email_change_sent_at                                               DateTime?                       @db.Timestamptz(6)
  last_sign_in_at                                                    DateTime?                       @db.Timestamptz(6)
  raw_app_meta_data                                                  Json?
  raw_user_meta_data                                                 Json?
  is_super_admin                                                     Boolean?
  created_at                                                         DateTime?                       @db.Timestamptz(6)
  updated_at                                                         DateTime?                       @db.Timestamptz(6)
  account_invitations_account_invitations_accepted_by_user_idTousers account_invitations[]           @relation("account_invitations_accepted_by_user_idTousers")
  account_invitations_account_invitations_created_by_user_idTousers  account_invitations[]           @relation("account_invitations_created_by_user_idTousers")
  accounts                                                           accounts?
  ai_configs_ai_configs_created_byTousers                            ai_configs[]                    @relation("ai_configs_created_byTousers")
  ai_configs_ai_configs_handoff_agent_idTousers                      ai_configs[]                    @relation("ai_configs_handoff_agent_idTousers")
  ai_knowledge_documents                                             ai_knowledge_documents[]
  api_keys                                                           api_keys[]
  automation_logs                                                    automation_logs[]
  automation_pending_executions                                      automation_pending_executions[]
  automations                                                        automations[]
  broadcasts                                                         broadcasts[]
  contact_notes                                                      contact_notes[]
  contacts                                                           contacts[]
  conversations                                                      conversations[]
  custom_fields                                                      custom_fields[]
  deals                                                              deals[]
  flow_runs                                                          flow_runs[]
  flows                                                              flows[]
  member_presence                                                    member_presence?
  message_templates                                                  message_templates[]
  notifications_notifications_actor_user_idTousers                   notifications[]                 @relation("notifications_actor_user_idTousers")
  notifications_notifications_user_idTousers                         notifications[]                 @relation("notifications_user_idTousers")
  pipelines                                                          pipelines[]
  profiles                                                           profiles?
  quick_replies                                                      quick_replies[]
  tags                                                               tags[]
  webhook_endpoints                                                  webhook_endpoints[]
  whatsapp_config                                                    whatsapp_config[]

  @@index([instance_id, email])
  @@index([instance_id])
  @@schema("auth")
}

